# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local: mongodb://127.0.0.1:27017/fixmate
# Atlas: mongodb+srv://<user>:<password>@<cluster-url>/fixmate?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/fixmate

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS
# Comma-separated list of allowed origins, e.g. https://myapp.com,https://staging.myapp.com
# Leave unset to allow all origins (fine for local dev / Flutter mobile clients).
CORS_ORIGIN=

# Admin registration (keep this secret; only used for the restricted admin registration endpoint)
ADMIN_REGISTRATION_KEY=replace_with_a_long_random_admin_setup_key
